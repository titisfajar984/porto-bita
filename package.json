    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
